NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-domain.example

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@RDS_ENDPOINT:5432/DB_NAME?sslmode=require
DB_HOST=RDS_ENDPOINT
DB_PORT=5432
DB_NAME=welive
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_SSL=true

JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value

REDIS_URL=redis://redis:6379

AWS_REGION=ap-northeast-2
S3_BUCKET=replace-with-private-bucket-name
ASSET_BASE_URL=https://assets.your-domain.example
