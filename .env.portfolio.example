# 배포 서버에 .env.portfolio로 복사한 뒤 실제 값으로 바꾼다. 이 예시를 그대로 실행하지 않는다.
SITE_HOST=203-0-113-10.sslip.io
CORS_ORIGIN=https://203-0-113-10.sslip.io
NODE_ENV=production
PORT=4000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=welive
DB_USER=welive
DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_HEX
DB_SSL=false
DATABASE_URL=postgresql://welive:CHANGE_ME_GENERATE_RANDOM_HEX@postgres:5432/welive
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_SECRET
AWS_REGION=ap-southeast-2
S3_BUCKET=unused-local
UPLOAD_STORAGE=local
LOCAL_ASSET_DIR=/app/uploads
ASSET_BASE_URL=
BACKEND_IMAGE=welive-backend:portfolio-arm64
FRONTEND_IMAGE=welive-frontend:portfolio-arm64
MIGRATION_IMAGE=welive-migration:portfolio-arm64
